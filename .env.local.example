# ==============================================================================
# Karbon AI - Konfigurasi Lingkungan Supabase
# ==============================================================================
# Salin file ini menjadi .env.local dan isi dengan kredensial proyek Supabase Anda:
# https://supabase.com/dashboard/project/_/settings/api
#
# PANDUAN PENGISIAN:
# 1. Buka Proyek Supabase Anda -> Project Settings -> API.
# 2. Salin "Project URL" ke NEXT_PUBLIC_SUPABASE_URL.
# 3. Salin "anon / public key" ke NEXT_PUBLIC_SUPABASE_ANON_KEY.
# 4. KUNCI RAHASIA (service_role secret) JANGAN PERNAH dimasukkan ke variabel NEXT_PUBLIC_*
#    karena akan terekspos ke browser pengguna.

# URL Proyek Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci Anonim Publik Supabase (Aman di browser, dibatasi Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# URL dasar aplikasi
NEXT_PUBLIC_SITE_URL=http://localhost:3000
