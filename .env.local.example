# ==============================================================================
# KarbonAI - Konfigurasi Lingkungan
# ==============================================================================
# Salin file ini menjadi .env.local dan isi dengan kredensial yang dibutuhkan:
#
# PANDUAN PENGISIAN:
# 1. Buka Proyek Supabase Anda -> Project Settings -> API.
# 2. Salin "Project URL" ke NEXT_PUBLIC_SUPABASE_URL.
# 3. Salin "anon / public key" ke NEXT_PUBLIC_SUPABASE_ANON_KEY.
# 4. KUNCI RAHASIA (service_role secret) JANGAN PERNAH dimasukkan ke variabel NEXT_PUBLIC_*
#    karena akan terekspos ke browser pengguna.

# URL Proyek Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci Anonim Publik Supabase (Aman di browser, dibatasi Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# URL dasar aplikasi
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# Konfigurasi AI untuk Fitur Green Action (Opsional / Recommended)
# ==============================================================================
# KarbonAI mendukung analisis personal berbasis AI menggunakan Google Gemini.
# Anda dapat memperoleh API Key gratis di Google AI Studio:
# https://aistudio.google.com/app/apikey
#
# KEAMANAN:
# Variabel ini HANYA dibaca di sisi server (Server-Side Route Handler) dan
# TIDAK menggunakan prefix NEXT_PUBLIC_*, sehingga kunci ini AMAN dan TIDAK
# PERNAH terekspos ke browser pengguna / client-side.
#
# CATATAN:
# Jika GEMINI_API_KEY tidak diisi, KarbonAI secara otomatis menggunakan
# fallback rekomendasi berbasis metodologi ilmiah ilmiah terverifikasi tanpa error.

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ==============================================================================
# Konfigurasi Notifikasi Email Mingguan (Resend & Vercel Cron)
# ==============================================================================
# Layanan email transaksional Resend (https://resend.com):
# API Key gratis dapat dibuat di dashboard Resend -> API Keys.
RESEND_API_KEY=re_your_resend_api_key_here

# Alamat pengirim email (misal: "KarbonAI <pengingat@karbon.app>" atau "onboarding@resend.dev")
EMAIL_FROM=KarbonAI <onboarding@resend.dev>

# Token rahasia otorisasi Vercel Cron / Scheduler Server-Side
CRON_SECRET=your_super_secret_cron_token_here

# Kunci Rahasia Service Role Supabase (Server-Side background tasks / cron)
# PERINGATAN: Kunci ini HANYA berada di server, JANGAN pernah gunakan prefix NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

